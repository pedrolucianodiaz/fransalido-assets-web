---
import { site, platforms } from "../data/site";

const hasImage = site.heroImage && site.heroImage.length > 0;
// Prefijo con la ruta base para que funcione en GitHub Pages (subcarpeta).
const heroSrc = hasImage
  ? import.meta.env.BASE_URL.replace(/\/$/, "") + site.heroImage
  : "";

// Logos de marca (fill: currentColor => toman el color del texto)
const icons: Record<string, string> = {
  spotify:
    '<path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.52 17.34c-.24.36-.66.48-1.02.24-2.82-1.74-6.36-2.1-10.56-1.14-.42.12-.78-.18-.9-.54-.12-.42.18-.78.54-.9 4.56-1.02 8.52-.6 11.64 1.32.42.18.48.66.3 1.02zm1.44-3.3c-.3.42-.84.6-1.26.3-3.24-1.98-8.16-2.58-11.94-1.38-.48.12-1.02-.12-1.14-.6-.12-.48.12-1.02.6-1.14 4.38-1.32 9.78-.66 13.5 1.62.42.24.54.84.24 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.1 9.3c-.6.18-1.2-.18-1.38-.72-.18-.6.18-1.2.72-1.38 4.32-1.26 11.4-1.02 15.9 1.62.54.3.72 1.02.42 1.56-.3.42-1.02.6-1.56.3z"/>',
  youtube:
    '<path d="M23.5 6.2a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.51A3.02 3.02 0 0 0 .5 6.2C0 8.07 0 12 0 12s0 3.93.5 5.8a3.02 3.02 0 0 0 2.12 2.14c1.88.51 9.38.51 9.38.51s7.5 0 9.38-.51a3.02 3.02 0 0 0 2.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.8zM9.55 15.57V8.43L15.82 12l-6.27 3.57z"/>',
  instagram:
    '<path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07zm0 1.44c-3.14 0-3.51.01-4.75.07-1.15.05-1.77.24-2.19.4-.55.21-.94.47-1.35.88-.41.41-.67.8-.88 1.35-.16.42-.35 1.04-.4 2.19-.06 1.24-.07 1.61-.07 4.75s.01 3.51.07 4.75c.05 1.15.24 1.77.4 2.19.21.55.47.94.88 1.35.41.41.8.67 1.35.88.42.16 1.04.35 2.19.4 1.24.06 1.61.07 4.75.07s3.51-.01 4.75-.07c1.15-.05 1.77-.24 2.19-.4.55-.21.94-.47 1.35-.88.41-.41.67-.8.88-1.35.16-.42.35-1.04.4-2.19.06-1.24.07-1.61.07-4.75s-.01-3.51-.07-4.75c-.05-1.15-.24-1.77-.4-2.19a3.6 3.6 0 0 0-.88-1.35 3.6 3.6 0 0 0-1.35-.88c-.42-.16-1.04-.35-2.19-.4-1.24-.06-1.61-.07-4.75-.07zm0 2.45a5.95 5.95 0 1 0 0 11.9 5.95 5.95 0 0 0 0-11.9zm0 9.82a3.87 3.87 0 1 1 0-7.74 3.87 3.87 0 0 1 0 7.74zm7.57-10.02a1.39 1.39 0 1 1-2.78 0 1.39 1.39 0 0 1 2.78 0z"/>',
};
---

<section
  id="inicio"
  class="relative flex min-h-screen items-center justify-center overflow-hidden"
>
  {/* Fondo: imagen si existe, si no un degradado */}
  {
    hasImage ? (
      <img
        src={heroSrc}
        alt=""
        class="absolute inset-0 h-full w-full object-cover object-[75%_center]"
        aria-hidden="true"
      />
    ) : (
      <div
        class="absolute inset-0 bg-gradient-to-br from-ink via-plum to-wine"
        aria-hidden="true"
      />
    )
  }

  {/* Overlay de color: durazno al centro -> plum -> casi negro a la izquierda, transparente a la derecha */}
  <div
    class="absolute inset-0 opacity-75 bg-[linear-gradient(to_left,transparent_0%,#f5b97d_45%,#411628_80%,#030402_100%)]"
    aria-hidden="true"
  >
  </div>

  {/* Contenido: alineado a la izquierda en desktop, centrado en mobile */}
  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl flex-col items-center px-6 text-center md:items-start md:text-left"
  >
    <p
      class="eyebrow mb-6 text-xs text-accent [text-shadow:0_1px_3px_rgba(0,0,0,0.95),0_2px_9px_rgba(0,0,0,0.75)]"
    >
      {site.tagline}
    </p>

    <h2
      class="font-display text-[2.1rem] leading-[0.95] uppercase text-cream sm:text-[3.15rem] lg:text-[4.2rem] [text-shadow:0_4px_14px_rgba(0,0,0,0.9),0_14px_55px_rgba(0,0,0,0.7),0_0_90px_rgba(0,0,0,0.5)]"
    >
      {site.heroTitle.map((line) => <span class="block">{line}</span>)}
    </h2>

    <p
      class="mt-8 max-w-xl text-base text-cream sm:text-lg [text-shadow:0_3px_11px_rgba(0,0,0,0.82),0_11px_42px_rgba(0,0,0,0.6)]"
    >
      {site.heroSubtitle}
    </p>

    {/* Listen & Subscribe On */}
    <div class="mt-12 w-full">
      <p
        class="eyebrow mb-5 text-[0.7rem] text-cream [text-shadow:0_1px_3px_rgba(0,0,0,0.95),0_2px_9px_rgba(0,0,0,0.75)]"
      >
        Escuchá y seguí en
      </p>
      <ul class="flex flex-wrap items-center justify-center gap-3 md:justify-start">
        {
          platforms.map((p) => (
            <li>
              <a
                href={p.href}
                target="_blank"
                rel="noopener noreferrer"
                class="eyebrow inline-flex items-center gap-2 rounded-full border border-cream/30 px-5 py-2.5 text-xs text-cream shadow-[0_4px_18px_rgba(0,0,0,0.55)] transition-all [text-shadow:0_1px_6px_rgba(0,0,0,0.7)] hover:border-accent hover:bg-accent hover:text-ink"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="h-4 w-4"
                  aria-hidden="true"
                  set:html={icons[p.icon]}
                />
                {p.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  {/* Indicador de scroll */}
  <div
    class="absolute bottom-8 left-1/2 z-10 -translate-x-1/2 animate-bounce text-cream/50"
    aria-hidden="true"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M12 5v14M19 12l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
</section>
