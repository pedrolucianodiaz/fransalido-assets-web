---
import { concerts, type Concert } from "../data/site";

const meses = [
  "ene", "feb", "mar", "abr", "may", "jun",
  "jul", "ago", "sep", "oct", "nov", "dic",
];

function parts(iso: string) {
  const [y, m, d] = iso.split("-").map(Number);
  return { day: String(d).padStart(2, "0"), month: meses[m - 1], year: y };
}

// Hoy (sin hora) para separar pasados de próximos.
const today = new Date();
today.setHours(0, 0, 0, 0);

const isFuture = (c: Concert) => new Date(c.date + "T00:00:00") >= today;

const upcoming = concerts
  .filter(isFuture)
  .sort((a, b) => a.date.localeCompare(b.date));
const past = concerts
  .filter((c) => !isFuture(c))
  .sort((a, b) => b.date.localeCompare(a.date)); // pasados: más reciente primero
---

<section id="shows" class="bg-ink px-6 py-24 text-cream">
  <div class="mx-auto max-w-4xl">
    <p class="eyebrow text-xs text-gold">En vivo</p>
    <h2 class="font-display mt-4 text-3xl uppercase sm:text-5xl">Conciertos</h2>

    {/* ---------- Próximas fechas (destacadas) ---------- */}
    {
      upcoming.length > 0 && (
        <div class="mt-12">
          <p class="eyebrow mb-6 text-xs text-cream/60">Próximas fechas</p>
          <ul class="space-y-4">
            {upcoming.map((c) => {
              const { day, month, year } = parts(c.date);
              return (
                <li class="relative grid grid-cols-1 items-center gap-4 overflow-hidden rounded-xl bg-cream px-6 py-5 text-ink sm:grid-cols-[auto_1fr_auto] sm:gap-8">
                  {/* Flag "Próximo" */}
                  <span class="absolute right-0 top-0 rounded-bl-lg bg-wine px-3 py-1 text-[0.6rem] uppercase tracking-widest text-cream">
                    Próximo
                  </span>

                  {/* Fecha */}
                  <div class="flex items-baseline gap-2 sm:flex-col sm:items-center sm:gap-0 sm:text-center">
                    <span class="font-display text-3xl leading-none text-wine sm:text-4xl">
                      {day}
                    </span>
                    <span class="eyebrow text-xs text-ink/60">
                      {month} {year}
                    </span>
                  </div>

                  {/* Ciudad + venue */}
                  <div class="min-w-0">
                    <p class="text-lg font-semibold text-ink">
                      {c.city}
                      <span class="font-normal text-ink/50"> · {c.country}</span>
                    </p>
                    <p class="text-sm text-ink/60">{c.venue}</p>
                  </div>

                  {/* Acción */}
                  <div class="sm:justify-self-end">
                    {c.soldOut ? (
                      <span class="eyebrow inline-block rounded-full border border-ink/25 px-5 py-2.5 text-xs text-ink/40">
                        Agotado
                      </span>
                    ) : (
                      <a
                        href={c.ticketUrl ?? "#"}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="eyebrow inline-block rounded-full bg-ink px-5 py-2.5 text-xs text-cream transition-opacity hover:opacity-85"
                      >
                        Entradas
                      </a>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      )
    }

    {/* ---------- Fechas pasadas (mismo estilo brillante que antes) ---------- */}
    {
      past.length > 0 && (
        <div class="mt-16">
          <p class="eyebrow mb-2 text-xs text-cream/60">Fechas pasadas</p>
          <ul class="border-t border-cream/15">
            {past.map((c) => {
              const { day, month, year } = parts(c.date);
              return (
                <li class="grid grid-cols-1 items-center gap-4 border-b border-cream/15 py-6 sm:grid-cols-[auto_1fr_auto] sm:gap-8">
                  <div class="flex items-baseline gap-2 sm:flex-col sm:items-center sm:gap-0 sm:text-center">
                    <span class="font-display text-3xl leading-none text-gold sm:text-4xl">
                      {day}
                    </span>
                    <span class="eyebrow text-xs text-cream/70">
                      {month} {year}
                    </span>
                  </div>
                  <div class="min-w-0">
                    <p class="text-lg font-medium text-cream">
                      {c.city}
                      <span class="text-cream/50"> · {c.country}</span>
                    </p>
                    <p class="text-sm text-cream/60">{c.venue}</p>
                  </div>
                  <div class="sm:justify-self-end">
                    <span class="eyebrow inline-block rounded-full border border-cream/20 px-5 py-2.5 text-xs text-cream/70">
                      Finalizado
                    </span>
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      )
    }
  </div>
</section>
