---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.tsx";
import Hero from "../components/Hero.astro";
import SpotifyPlayer from "../components/SpotifyPlayer.astro";
import Concerts from "../components/Concerts.astro";
import Footer from "../components/Footer.astro";
import { spotify } from "../data/site";
---

<Layout>
  <!-- client:load hidrata el header (scroll + menu mobile) en el cliente -->
  <Header client:load />
  <Hero />

  <!-- Seccion Musica con el reproductor de Spotify -->
  <section id="musica" class="bg-cream px-6 py-24 text-ink">
    <div class="mx-auto max-w-4xl">
      <p class="eyebrow text-xs text-wine">Música</p>
      <h2 class="font-display mt-4 text-3xl uppercase sm:text-5xl">
        Santiagueña Luz Nativa
      </h2>
      <p class="mt-6 max-w-xl text-ink/70">
        Escuchá el último lanzamiento. Podés reproducirlo acá mismo o abrirlo en
        Spotify.
      </p>

      <div class="mt-10">
        <SpotifyPlayer shareUrl={spotify.shareUrl} height={1050} />
      </div>
    </div>
  </section>

  <!-- Grilla de conciertos -->
  <Concerts />

  <Footer />
</Layout>
