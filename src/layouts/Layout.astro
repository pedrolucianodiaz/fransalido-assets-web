---
import "../styles/global.css";
import { site, seo, platforms } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = seo.title, description = seo.description } = Astro.props;

// URLs absolutas para SEO/redes (Astro.site + base).
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(
  import.meta.env.BASE_URL.replace(/\/$/, "") + seo.ogImage,
  Astro.site
).toString();

// Datos estructurados: artista musical (mejora el SEO en buscadores).
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicGroup",
  name: site.artist,
  description: seo.description,
  genre: seo.genres,
  url: canonical.toString(),
  image: ogImageUrl,
  sameAs: platforms.map((p) => p.href),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={seo.keywords.join(", ")} />
    <meta name="author" content={site.artist} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      type="image/svg+xml"
      href={import.meta.env.BASE_URL + "favicon.svg"}
    />

    <!-- Open Graph (Facebook, WhatsApp, etc.) -->
    <meta property="og:type" content="music.musician" />
    <meta property="og:site_name" content={site.artist} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Datos estructurados -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Fuentes: Boldonse (display) + Jost (texto) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Boldonse&family=Jost:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
